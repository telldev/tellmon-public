# Canonical deployment Compose file; rendered by refresh-compose-tasks.yml.
# Compose is the only startup mechanism: `docker compose up --wait` orders the
# services by depends_on/healthchecks, and Docker restores them at boot through
# restart: unless-stopped. ./run holds the host listener's reboot.sock; it is
# mounted as a directory so a recreated socket is visible without recreating
# the containers.
services:
  caddy:
    image: tellsoftware/tellmon-caddy:latest
    restart: unless-stopped
    volumes:
      - ./config/caddy:/etc/caddy
      - ./config/certificate:/etc/caddy/certs:ro
      - caddy_data:/data/caddy
      - caddy_config:/config
    # Reach the backend on host loopback through the existing Caddy upstream.
    network_mode: host
    extra_hosts:
      - "backend:127.0.0.1"
    depends_on:
      backend:
        condition: service_healthy
    logging:
      options:
        max-size: "50m"
        max-file: "5"

  postgres:
    container_name: tellmon_db
    restart: unless-stopped
    image: postgres:16.1-alpine
    logging:
      options:
        max-size: "50m"
        max-file: "5"
    ports:
      - 127.0.0.1:5432:5432
    volumes:
      - tellmon_db_data:/var/lib/postgresql/data
    environment:
      POSTGRES_USER: root
      POSTGRES_PASSWORD: {{ postgres_password | default('secret') | to_json }}
      POSTGRES_DB: "tellmon"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U root -d postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  mqtt:
    container_name: tellmon_mqtt
    restart: unless-stopped
    image: eclipse-mosquitto:2.0.20
    # Start order: manager -> mqtt -> receiver.
    depends_on:
      manager:
        condition: service_healthy
    logging:
      options:
        max-size: "50m"
        max-file: "5"
    ports:
      # Receiver (host network) uses plaintext on loopback: localhost:1883.
      - 127.0.0.1:1883:1884
      # External clients: TLS once the MQTT certificate is generated.
      - 8883:1883
    volumes:
      - ./config/mqtt:/mosquitto/config:ro
      - ./config/certificate/mqtt:/mosquitto/certs:ro
      - mqtt_data:/mosquitto/data
    healthcheck:
      # Works with and without authentication: a "not authorised" CONNACK still
      # proves the broker is up and speaking MQTT.
      test: ["CMD-SHELL", "out=$$(mosquitto_sub -h 127.0.0.1 -p 1884 -t '$$SYS/broker/uptime' -C 1 -W 3 2>&1) || echo \"$$out\" | grep -q 'not authorised'"]
      interval: 10s
      timeout: 5s
      retries: 5

  receiver:
    container_name: tellmon_receiver
    restart: unless-stopped
    image: tellsoftware/tellmon-receiver:latest
    logging:
      options:
        max-size: "50m"
        max-file: "5"
    depends_on:
      postgres:
        condition: service_healthy
      manager:
        condition: service_healthy
      # Only started, not healthy: a broken broker must not stop alarm
      # reception. The receiver keeps retrying the MQTT connection itself.
      mqtt:
        condition: service_started
    # Use host interfaces, including dynamically created PPP interfaces.
    network_mode: host
    extra_hosts:
      # The receiver reads the shared JDBC configuration directly.
      - "postgres:127.0.0.1"
    environment:
      MANAGER_URL: "http://127.0.0.1:8890"
      SPRING_PROFILES_ACTIVE: docker
{% if is_physical_mode %}
    # Devices are reached through the /dev mount below rather than `devices:`,
    # so a modem that appears late at boot never prevents the container from
    # starting. Allowed: ttyS (4), ppp (108), ttyACM (166), ttyUSB (188).
    device_cgroup_rules:
      - 'c 4:* rwm'
      - 'c 108:0 rwm'
      - 'c 166:* rwm'
      - 'c 188:* rwm'
    cap_add:
      - NET_ADMIN
{% endif %}
    group_add:
      - dialout
    volumes:
{% if is_physical_mode %}
      - /dev:/dev
{% endif %}
      - ./config:/home/tellmon/TELLMon/config
      - ./bin:/home/tellmon/TELLMon/bin
      - ./device_updates:/home/tellmon/TELLMon/device_updates
      - ./run:/run/tellmon
      - /sys:/host/sys:ro
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f tellreceiver || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  backend:
    container_name: tellmon_backend
    restart: unless-stopped
    image: tellsoftware/tellmon-backend:latest
    logging:
      options:
        max-size: "50m"
        max-file: "5"
    depends_on:
      postgres:
        condition: service_healthy
      receiver:
        condition: service_healthy
      manager:
        condition: service_healthy
    # Connect to the receiver admin listener on host loopback.
    network_mode: host
    extra_hosts:
      - "postgres:127.0.0.1"
    environment:
      MANAGER_URL: "http://127.0.0.1:8890"
      APP_RECEIVER_HOST: "127.0.0.1"
      SERVER_ADDRESS: "127.0.0.1"
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_PASSWORD: {{ postgres_password | default('secret') | to_json }}
{% if is_physical_mode %}
    device_cgroup_rules:
      - 'c 4:* rwm'
      - 'c 166:* rwm'
      - 'c 188:* rwm'
{% endif %}
    group_add:
      - dialout
    volumes:
{% if is_physical_mode %}
      - /dev:/dev
{% endif %}
      - ./config:/home/tellmon/TELLMon/config
      - ./bin:/home/tellmon/TELLMon/bin
      - ./device_updates:/home/tellmon/TELLMon/device_updates
      - ./run:/run/tellmon
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 8889 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  manager:
    container_name: tellmon_manager
    restart: unless-stopped
    image: tellsoftware/tellmon-manager:latest
    # Share host interfaces so Java can inspect the real network.
    network_mode: host
    logging:
      options:
        max-size: "50m"
        max-file: "5"
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      # PostgreSQL is published on host loopback; Docker DNS is unavailable here.
      SPRING_DATASOURCE_URL: "jdbc:postgresql://127.0.0.1:5432/tellmon"
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: {{ postgres_password | default('secret') | to_json }}
      MANAGER_PORT: "8890"
      # The manager entrypoint records this as tellmon.physical in the shared
      # application.properties, which the receiver, backend and host scripts read.
      PHYSICAL_MODE: "{{ 'true' if is_physical_mode else 'false' }}"
      SERVER_ADDRESS: "127.0.0.1"
    volumes:
      - /sys:/host/sys:ro
      - ./run:/run/tellmon
      - ./config:/home/tellmon/TELLMon/config
      - ./bin:/home/tellmon/TELLMon/bin
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 8890 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

volumes:
  tellmon_db_data:
  caddy_data:
  caddy_config:
  mqtt_data:
