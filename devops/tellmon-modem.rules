# Tellmon owns these modems; ModemManager must not probe their AT ports.
ATTRS{idVendor}=="05c6", ATTRS{idProduct}=="9003", ENV{ID_MM_DEVICE_IGNORE}="1"
ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", ENV{ID_MM_DEVICE_IGNORE}="1"
# Match modem interfaces rather than Linux ttyUSB enumeration order. /dev is
# rebuilt at every boot, so these rules are the only thing that recreates the
# links; never create them by hand. Every supported modem gets the same names
# because wvdial.conf and the receiver use /dev/ttyUSB-UC20-AT and -Modem.
# Quectel UC20 (05c6:9003): interface 02 = AT, 03 = PPP data.
ACTION=="add|change", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="05c6", ENV{ID_MODEL_ID}=="9003", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="ttyUSB-UC20-AT", GROUP="dialout"
ACTION=="add|change", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="05c6", ENV{ID_MODEL_ID}=="9003", ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="ttyUSB-UC20-Modem", GROUP="dialout"
# Quectel UC25/EC25 (2c7c:0125): same interface layout as the UC20.
ACTION=="add|change", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="2c7c", ENV{ID_MODEL_ID}=="0125", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="ttyUSB-UC20-AT", GROUP="dialout"
ACTION=="add|change", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="2c7c", ENV{ID_MODEL_ID}=="0125", ENV{ID_USB_INTERFACE_NUM}=="03", SYMLINK+="ttyUSB-UC20-Modem", GROUP="dialout"
# /dev/ppp is recreated at every boot; keep it usable by the receiver's pppd.
KERNEL=="ppp", MODE="0666"
